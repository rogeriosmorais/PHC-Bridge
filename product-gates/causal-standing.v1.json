        "movement_reclaim_count",
        "shell_helper_used_count",
        "topology_change_count",
        "pose_rms_error_deg"
      ]
    },
    "policy": {
      "clock": "policy_step",
      "expected_rate_hz": 30,
      "required_fields": [
        "sequence",
        "time_sec",
        "pose_search_valid",
        "selected_animation",
        "inference_attempted",
        "inference_succeeded",
        "raw_action_l2",
        "conditioned_action_l2",
        "target_write_attempt_count",
        "target_readback_match_count",
        "target_readback_max_error_deg"
      ]
    }
  },
  "perturbation": {
    "body": "pelvis",
    "direction": "world_forward",
    "application": "velocity_change",
    "delta_v_cm_per_sec": 15.0
  },
  "acceptance": {
    "startup_timeout_sec": 20.0,
    "standing_window_sec": 10.0,
    "baseline_window_sec": 2.0,
    "post_perturbation_window_sec": 8.0,
    "perturbation_delta_v_cm_per_sec": 15.0,
    "recovery_deadline_sec": 3.0,
    "recovery_hold_sec": 2.0,
    "recovery_pose_rms_floor_deg": 10.0,
    "recovery_pose_rms_baseline_multiplier": 1.5,
    "minimum_pelvis_height_ratio": 0.7,
    "maximum_root_tilt_deg": 45.0,
    "maximum_penetration_cm": 2.0,
    "maximum_support_gap_ms": 100.0,
    "minimum_policy_step_coverage": 0.9,
    "maximum_target_readback_error_deg": 0.5,
    "minimum_target_readback_match_ratio": 0.95,
    "normal_to_zero_recovery_auc_ratio_max": 0.8,
    "required_runtime_state": "BalanceActive_Standing",
    "required_pose_search_animation": "MM_Idle",
    "required_critical_body_mask": 63,
    "required_support_body_mask": 15,
    "require_root_simulating": true,
    "require_zero_inference_failures": true,
    "require_cmc_inactive": true,
    "require_capsule_collision_disabled": true,
    "require_no_movement_reclaim": true,
    "require_no_shell_helper": true,
    "require_no_topology_change": true,
    "require_nonblank_render_capture": true
  },
  "verdict_rules": {
    "PASS": "All three Normal repetitions satisfy every absolute criterion, paired Normal recovery AUC is at most 80 percent of ZeroActions, and both destructive controls are rejected for their intended reason.",
