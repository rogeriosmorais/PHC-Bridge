  "repetitions": {
    "Normal": 3,
    "ZeroActions": 3,
    "DropControlDispatch": 1,
    "ForcedSupportLoss": 1
  },
  "sample_streams": {
    "physics": {
      "clock": "game_tick",
      "required_fields": [
        "sequence",
        "time_sec",
